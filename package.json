{
  "name": "rozes",
  "displayName": "RoZES: Robust ZX-Calculus Extension for String-diagrams",
  "publisher": "daniel-liao07",
  "repository": {
    "type": "git",
    "url": "https://github.com/danielliao07/RoZES.git"
  },
  "description": "A live ZX-Calculus visualizer using TensorRocq and VyZX integrated with VSRocq",
  "version": "0.0.2",
  "engines": {
    "vscode": "^1.116.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "*"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "RoZES",
      "properties": {
        "rozes.layout.columnGap": {
          "type": "number",
          "default": 100,
          "minimum": 0,
          "description": "Horizontal gap between columns of boxes in pixels."
        },
        "rozes.layout.boxGap": {
          "type": "number",
          "default": 40,
          "minimum": 0,
          "description": "Vertical gap between boxes in the same column in pixels."
        },
        "rozes.layout.wireClearance": {
          "type": "number",
          "default": 25,
          "minimum": 0,
          "description": "Clearance between wires and boxes in pixels."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production && node build.mjs --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test",
    "preview": "esbuild src/test/preview.tsx --bundle --platform=node --format=cjs --jsx=automatic --jsx-import-source=preact --outfile=dist/preview.cjs --log-level=warning && node dist/preview.cjs"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.19.21",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/vscode": "^1.116.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.27.3",
    "eslint": "^9.39.3",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  },
  "dependencies": {
    "chyp2": "github:akissinger/chyp2",
    "elkjs": "^0.12.1",
    "preact-render-to-string": "^6.7.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "vscode-languageclient": "^9.0.1"
  },
  "extensionDependencies": [
    "rocq-prover.vsrocq"
  ]
}